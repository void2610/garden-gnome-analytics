{
  "name": "@gga/parser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "ingest": "./src/cli/ingest.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsup src/index.ts src/cli/ingest.ts --format esm --dts --clean",
    "ingest": "tsx src/cli/ingest.ts",
    "dev": "tsx --watch src/cli/ingest.ts"
  },
  "dependencies": {
    "@gga/shared": "workspace:*",
    "@duckdb/node-api": "^1.5.2-r.1",
    "fast-glob": "^3.3.2",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
